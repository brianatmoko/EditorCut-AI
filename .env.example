# ──────────────────────────────────────────────────────────────────────
# OpenCut AI — Environment Variables
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# The app reads these as fallback when opencut_config.json has no value.
# ──────────────────────────────────────────────────────────────────────

# ── AI Gateway Keys ───────────────────────────────────────────────────
# Google Gemini / AI Studio — get your FREE API key at aistudio.google.com
GEMINI_API_KEY=""
GEMINI_API_KEY_ALT=""
# Extra Gemini keys for multi-agent parallel workers (comma-separated)
GEMINI_API_KEYS=""

# OpenRouter — free LLM gateway (openrouter.ai/keys)
OPENROUTER_API_KEY="sk-or-v1-..."

# ── Asset API Keys ───────────────────────────────────────────────────
# Pexels — free stock video/images (pexels.com/api)
PEXELS_API_KEY=""

# Pixabay — free stock video/images (pixabay.com/api)
PIXABAY_API_KEY=""

# ── Local Gateway Keys ───────────────────────────────────────────────
# Only needed if you run custom local gateways
OPENCODE_API_KEY="opencode-free"
OMNIROUTE_API_KEY="omni-free"
NINEROUTE_API_KEY="nine-free"

# ── Alternative Key Names (legacy compat) ────────────────────────────
# MOKO_OPENROUTER_KEY=""
# MOKO_OPENCODE_KEYS=""
# MOKO_OMNIROUTE_KEYS=""
# MOKO_NINEROUTE_KEYS=""
